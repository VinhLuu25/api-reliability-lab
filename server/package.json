{
  "name": "api-reliability-lab-server",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "db:migrate:test": "node --env-file-if-exists=.env.test --import tsx src/migrate.ts",
    "test:db": "node --env-file-if-exists=.env.test --import tsx --test test/integration/*.test.ts",
    "test:orders": "node --env-file-if-exists=.env.test --import tsx --test test/integration/orderReliability.test.ts",
    "demo:orders": "node --env-file-if-exists=.env scripts/orders-demo.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
